% ---------- Framed boxes (style inspired by the Nyx notes) ----------
\RequirePackage[most]{tcolorbox}
\RequirePackage{etoolbox}

% \newframedbox{env}{Name}{color}
% Usage: \begin{frameddefn}{Title} ... \end{frameddefn}
%        \begin{frameddefn}[label={def:x}]{Title} ... \end{frameddefn}
\newcommand{\newframedbox}[3]{%
  \newtcolorbox[auto counter, number within=chapter]{#1}[2][]{%
    enhanced, breakable,
    colback=white, colframe=#3!55!white, boxrule=0.6pt, arc=2pt,
    left=6pt, right=6pt, top=8pt, bottom=6pt,
    before skip=12pt, after skip=10pt,
    fonttitle=\bfseries\color{black},
    attach boxed title to top left={xshift=8mm, yshift*=-\tcboxedtitleheight/2},
    boxed title style={colback=#3!35!white, colframe=#3!35!white,
      sharp corners, boxrule=0pt,
      interior code={\fill[#3!35!white] ([xshift=-3mm]frame.south west)
        -- ([xshift=3mm]frame.south east) -- (frame.north east)
        -- (frame.north west) -- cycle;}},
    title={#2~\thetcbcounter\ifstrempty{##2}{}{: ##2}},
    ##1}}

\newframedbox{frameddefn}{Definition}{ForestGreen}
\newframedbox{framedthm}{Theorem}{BrickRed}
\newframedbox{framedlem}{Lemma}{Orange}
\newframedbox{framedprop}{Proposition}{RoyalBlue}
\newframedbox{framedcor}{Corollary}{RoyalBlue}
\newframedbox{framedobs}{Observation}{Goldenrod}
\newframedbox{framedex}{Example}{TealBlue}
\newframedbox{framedprob}{Problem}{Purple}
\newframedbox{framedalgo}{Algorithm}{Gray}

% Proofs: standard amsthm \begin{proof} ... \end{proof}

% ---------- Space-time diagrams ----------
% \proc{y}{name}{x_end}         process line at height y
% \node[ev] (a) at (x,y) {};    event dot
% \draw[msg] (a) -- (b);        message arrow
\tikzset{
  ev/.style={circle, fill=black, inner sep=0pt, minimum size=4pt},
  msg/.style={-{Stealth[length=2.2mm]}, thick},
  ctrl/.style={-{Stealth[length=2mm]}, dashed, gray},
  cutline/.style={very thick, rounded corners=4pt},
  lbl/.style={font=\scriptsize},
}
\newcommand{\proc}[3]{%
  \draw[-{Latex}, gray!70] (0,#1) -- (#3,#1);
  \node[left] at (0,#1) {$#2$};}

