% ---------- Riquadri degli appunti ----------
% Fatti con il pacchetto framed (molto più veloce di tcolorbox: compila in pochi secondi anche su Overleaf).
% Si spezzano da soli tra una pagina e l'altra.
\RequirePackage{framed}
% \appbox{colore barra}{colore sfondo}{titolo o vuoto}
\newenvironment{appbox}[3]{%
  \def\FrameCommand{{\color{#1}\vrule width 2.5pt}\fboxsep=7pt\colorbox{#2}}%
  \Needspace{4\baselineskip}%
  \MakeFramed{\advance\hsize-\width \FrameRestore}%
  \ifx\relax#3\relax\else\noindent{\bfseries\color{#1}#3}\par\smallskip\fi
}{\endMakeFramed}
% inbreve: la definizione corta prima di ogni concetto importante
\newenvironment{inbreve}{\begin{appbox}{RoyalBlue}{RoyalBlue!7}{In breve}}{\end{appbox}}
\newenvironment{esempio}{\begin{appbox}{TealBlue}{TealBlue!6}{}}{\end{appbox}}
\newenvironment{nota}{\begin{appbox}{Gray!70}{Gray!8}{}}{\end{appbox}}
% approfondimento{Titolo}: dimostrazioni, soluzioni, domande di ripasso
\newenvironment{approfondimento}[1]{\begin{appbox}{Goldenrod}{Goldenrod!10}{#1}}{\end{appbox}}

